# Copy to .env (git-ignored). Never commit real credentials.
PORT=3000

# --- Mail notifications (optional) ---
# gmail | gmx | custom. Leave MAIL_PROVIDER empty to disable.
MAIL_PROVIDER=
MAIL_USER=
# App password (Gmail: 16 characters from myaccount.google.com/apppasswords; GMX: app password or normal password)
MAIL_PASS=
# Only for MAIL_PROVIDER=custom:
MAIL_HOST=
MAIL_PORT=993
MAIL_LOOKBACK_DAYS=30
